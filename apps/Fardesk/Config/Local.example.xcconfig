// Copy to Local.xcconfig (gitignored). scripts/setup/30-app-config.sh writes these lines for you from fardesk.env.
// The app has no other built-in setting: machines come from pairing, their order from the app's settings screen.
//
// Identity of your build: bundle ids are <prefix>.fardesk, the App Group is group.<prefix>.fardesk.
FARDESK_BUNDLE_PREFIX = com.example
// Your Apple developer team id; empty = choose the team in Xcode.
FARDESK_TEAM_ID =
