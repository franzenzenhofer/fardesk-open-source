# Copy to fardesk.env (git ignores it) and fill it in. Plain KEY=value lines: the scripts in scripts/setup/ and
# deploy/ source it, and nothing in a tracked file needs an edit. A variable set in the environment wins over this file.

# --- Identity of your build (iPhone and Mac app) ---
# Reverse-DNS prefix you own. Bundle ids become <prefix>.fardesk, the App Group group.<prefix>.fardesk and the
# launchd label of the daemon <prefix>.fardeskd.
FARDESK_BUNDLE_PREFIX=com.example
# Your Apple developer team id (10 characters). Empty = choose the team in Xcode.
FARDESK_TEAM_ID=

# --- Machines ---
# "Name|ssh target|tailnet host" separated by ";". The ssh target "local" is the computer you run the scripts on.
# The tailnet host (name or IP, the address the phone and the hub use) is optional; it defaults to the ssh target.
FARDESK_MACHINES="Studio|local|100.64.0.1;Laptop|laptop|100.64.0.2;Build server|build|100.64.0.10"
# Name of the hub machine (one of the names above). Empty = no hub, the phone pairs with each machine.
FARDESK_HUB="Build server"
# Names listed first in the app's session list, in this order, separated by ";". Empty = alphabetical.
FARDESK_MACHINE_ORDER=
FARDESK_PORT=4780

# --- Safety (these are the defaults) ---
# Sessions started from the phone may skip permission prompts.
FARDESK_ALLOW_BYPASS=false
# Enable the Coordinator on the hub.
FARDESK_COORDINATOR=false
# The Coordinator may use Bash, Edit, Write and the other built-in tools (else only Read and Grep plus the fardesk tools).
FARDESK_COORDINATOR_FULL_TOOLS=false
# What a push notification shows: generic (only "Fardesk" and the machine name) or full (titles and text).
FARDESK_PUSH_CONTENT=generic

# --- Optional: push notifications (needs a paid Apple developer account) ---
FARDESK_APNS_KEY_PATH=
FARDESK_APNS_KEY_ID=

# --- Optional: TestFlight instead of Xcode run-to-device ---
ASC_APP_ID=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

# --- Optional developer conveniences for the app (written into apps/Fardesk/Config/Local.xcconfig) ---
# Machines the app knows before the first login: Name|URL;Name|URL
FARDESK_APP_BOOTSTRAP_MACHINES=
# The hub URL the app goes through, for example http://100.64.0.10:4780
FARDESK_APP_HUB_URL=

# --- Optional: UI tests on a second Mac ---
FARDESK_SIM_HOST=
# Folder on the hub machine in which the UI tests start their own session.
FARDESK_UITEST_FOLDER=
