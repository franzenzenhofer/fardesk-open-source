[Unit]
Description=Fardesk daemon (Claude Code session control)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=__NODE__ __INSTALL_DIR__/dist/main.js serve
WorkingDirectory=__INSTALL_DIR__
Environment=PATH=__PATH__
# An update runs the installer from inside the daemon; the installer restarts this unit and must survive it.
KillMode=process
Environment=FARDESK_LABEL=__LABEL__
Restart=always
RestartSec=5
StandardOutput=append:__LOG_DIR__/fardeskd.out.log
StandardError=append:__LOG_DIR__/fardeskd.err.log

[Install]
WantedBy=default.target
