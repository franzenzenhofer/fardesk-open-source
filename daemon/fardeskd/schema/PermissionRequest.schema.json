{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fardesk.local/schema/PermissionRequest.schema.json",
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "allow_always",
        "approve_bypass",
        "approve_manual",
        "revise"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "decision"
  ],
  "additionalProperties": false
}
