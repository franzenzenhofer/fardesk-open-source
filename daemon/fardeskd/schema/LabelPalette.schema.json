{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fardesk.local/schema/LabelPalette.schema.json",
  "minItems": 64,
  "maxItems": 64,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9A-F]{6}$"
      }
    },
    "required": [
      "name",
      "color"
    ],
    "additionalProperties": false
  }
}
