{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fardesk.local/schema/LoginResult.schema.json",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "minLength": 32
    },
    "deviceId": {
      "type": "string",
      "minLength": 1
    },
    "machine": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "type": "number",
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "enum": [
            "macos",
            "linux"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "claudeVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionsCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ghosttyAutomation": {
          "type": "string",
          "enum": [
            "ok",
            "denied",
            "unknown"
          ]
        },
        "allowBypass": {
          "type": "boolean"
        },
        "coordinatorEnabled": {
          "type": "boolean"
        }
      },
      "required": [
        "contractVersion",
        "name",
        "hostname",
        "os",
        "version",
        "claudeVersion",
        "sessionsCount",
        "models",
        "ghosttyAutomation",
        "allowBypass",
        "coordinatorEnabled"
      ],
      "additionalProperties": false
    },
    "peers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "name",
          "url"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "token",
    "deviceId",
    "machine",
    "peers"
  ],
  "additionalProperties": false
}
