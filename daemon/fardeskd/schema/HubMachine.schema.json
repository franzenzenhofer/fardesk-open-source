{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fardesk.local/schema/HubMachine.schema.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "online": {
      "type": "boolean"
    },
    "hub": {
      "type": "boolean"
    },
    "lastSeen": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "latencyMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "problem": {
      "type": [
        "string",
        "null"
      ]
    },
    "sessions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "waiting": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "working": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "os": {
      "type": "string",
      "enum": [
        "macos",
        "linux"
      ]
    }
  },
  "required": [
    "name",
    "online",
    "hub",
    "lastSeen",
    "latencyMs",
    "problem",
    "sessions",
    "waiting",
    "working"
  ],
  "additionalProperties": false
}
