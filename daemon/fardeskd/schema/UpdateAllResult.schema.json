{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fardesk.local/schema/UpdateAllResult.schema.json",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "machines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "started",
              "current",
              "failed"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "from",
          "result",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "source",
    "version",
    "machines"
  ],
  "additionalProperties": false
}
