{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fardesk.local/schema/FolderSearch.schema.json",
  "type": "object",
  "properties": {
    "folders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "recent": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "recent"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "folders"
  ],
  "additionalProperties": false
}
