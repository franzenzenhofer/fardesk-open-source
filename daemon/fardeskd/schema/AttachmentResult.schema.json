{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fardesk.local/schema/AttachmentResult.schema.json",
  "type": "object",
  "properties": {
    "attachmentId": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "mediaType": {
      "type": "string",
      "minLength": 1
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "attachmentId",
    "path",
    "mediaType",
    "bytes"
  ],
  "additionalProperties": false
}
