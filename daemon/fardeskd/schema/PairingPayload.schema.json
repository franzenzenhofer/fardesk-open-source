{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fardesk.local/schema/PairingPayload.schema.json",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 4
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "code": {
      "type": "string",
      "minLength": 32
    },
    "hub": {
      "type": "boolean"
    }
  },
  "required": [
    "v",
    "name",
    "url",
    "code",
    "hub"
  ],
  "additionalProperties": false
}
