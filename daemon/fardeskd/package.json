{
  "name": "fardeskd",
  "version": "2.0.1",
  "private": true,
  "description": "Fardesk daemon: observes and controls Claude Code sessions on one machine",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "fardeskd": "dist/main.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "schema": "tsx scripts/generate-schema.ts",
    "gates": "npm run dry && npm run gates:daemon",
    "dry": "bash ../../scripts/dry-gate.sh",
    "gates:daemon": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "qrcode": "^1.5.4",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "eslint": "^10.15.0",
    "jscpd": "^5.4.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
